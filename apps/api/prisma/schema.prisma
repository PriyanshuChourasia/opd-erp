model EmployeeSchedule {
  id                      String   @id @default(uuid())
  dayOfWeek               Int
  startTime               String
  endTime                 String
  shiftId                 String?
  employeeSchedulableType String
  employeeSchedulableId   String
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt
  createdById             String?
  updatedById             String?
  createdBy               User?    @relation("EmployeeScheduleCreated", fields: [createdById], references: [id])
  updatedBy               User?    @relation("EmployeeScheduleUpdated", fields: [updatedById], references: [id])
  shift                   Shift?   @relation(fields: [shiftId], references: [id], onDelete: SetNull)

  deletedAt   DateTime?
  deletedById String?
  deletedBy   User?    @relation("EmployeeScheduleDeleted", fields: [deletedById], references: [id])
  @@index([employeeSchedulableType, employeeSchedulableId, dayOfWeek], map: "emp_sched_type_id_dow")
  @@index([employeeSchedulableType, employeeSchedulableId], map: "emp_sched_type_id")
  @@index([createdById])
  @@index([updatedById])
}

model Address {
