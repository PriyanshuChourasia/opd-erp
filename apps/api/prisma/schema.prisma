generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id              String         @id @default(uuid())
  username        String         @unique
  firstName       String
  middleName      String?
  lastName        String
  gender          String? // MALE | FEMALE | OTHER
  dateOfBirth     DateTime?
  email           String         @unique
  mobileNumber    String?
  countryCode     String         @default("+91")
  profilePhotoUrl String?
  qualification   String?
  password        String
  isActive        Boolean        @default(true)
  roleId          String
  userableType    String? // "Doctor" | "Patient" | "Nurse" | "Receptionist" | "Pharmacist" | "LabStaff"
  userableId      String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  role            Role           @relation(fields: [roleId], references: [id])
  refreshTokens   RefreshToken[]

  // Audit relations — Created by
  createdRoles                 Role[]                 @relation("RoleCreated")
  createdPermissions           Permission[]           @relation("PermissionCreated")
  createdRefreshTokens         RefreshToken[]         @relation("RefreshTokenCreated")
  createdAllergies             Allergy[]              @relation("AllergyCreated")
  createdPatientAllergies      PatientAllergy[]       @relation("PatientAllergyCreated")
  createdDiagnoses             Diagnosis[]            @relation("DiagnosisCreated")
  createdPatients              Patient[]              @relation("PatientCreated")
  createdDoctors               Doctor[]               @relation("DoctorCreated")
  createdQueueEntries          QueueEntry[]           @relation("QueueEntryCreated")
  createdAppointments          Appointment[]          @relation("AppointmentCreated")
  createdMedicines             Medicine[]             @relation("MedicineCreated")
  createdPrescriptions         Prescription[]         @relation("PrescriptionCreated")
  createdPrescriptionItems     PrescriptionItem[]     @relation("PrescriptionItemCreated")
  createdLabOrders             LabOrder[]             @relation("LabOrderCreated")
  createdRadiologyOrders       RadiologyOrder[]       @relation("RadiologyOrderCreated")
  createdProcedureOrders       ProcedureOrder[]       @relation("ProcedureOrderCreated")
  createdBills                 Bill[]                 @relation("BillCreated")
  createdBillItems             BillItem[]             @relation("BillItemCreated")
  createdDispensings           Dispensing[]           @relation("DispensingCreated")
  createdShifts                Shift[]                @relation("ShiftCreated")
  createdEmployeeSchedules     EmployeeSchedule[]     @relation("EmployeeScheduleCreated")
  createdAddresses             Address[]              @relation("AddressCreated")
  createdDocuments             Document[]             @relation("DocumentCreated")
  createdCompanies             Company[]              @relation("CompanyCreated")
  createdPatientVitals         PatientVitals[]        @relation("PatientVitalsCreated")
  createdPatientAllergyRecords PatientAllergyRecord[] @relation("PatientAllergyRecordCreated")
  createdDiagnosisSystems      DiagnosisSystem[]      @relation("DiagnosisSystemCreated")
  createdPrescriptionTemplates PrescriptionTemplate[] @relation("PrescriptionTemplateCreated")
  createdSpecializations       Specialization[]        @relation("SpecializationCreated")
  createdPrescriptionHistories PrescriptionHistory[]  @relation("PrescriptionHistoryCreated")
  createdAppointmentHistories  AppointmentHistory[]  @relation("AppointmentHistoryCreated")
  createdMedicineGroups         MedicineGroup[]       @relation("MedicineGroupCreated")
  createdUnits                  Unit[]                @relation("UnitCreated")
  createdDepartments            Department[]          @relation("DepartmentCreated")
  createdDesignations           Designation[]         @relation("DesignationCreated")
  createdFinancialYears         FinancialYear[]       @relation("FinancialYearCreated")
  createdDoctorDepartments      DoctorDepartment[]    @relation("DoctorDepartmentCreated")
  createdDoctorSpecializations  DoctorSpecialization[] @relation("DoctorSpecializationCreated")
  createdBloodGroups            BloodGroup[]          @relation("BloodGroupCreated")

  // Audit relations — Updated by
  updatedRoles                 Role[]                 @relation("RoleUpdated")
  updatedPermissions           Permission[]           @relation("PermissionUpdated")
  updatedRefreshTokens         RefreshToken[]         @relation("RefreshTokenUpdated")
  updatedAllergies             Allergy[]              @relation("AllergyUpdated")
  updatedPatientAllergies      PatientAllergy[]       @relation("PatientAllergyUpdated")
  updatedDiagnoses             Diagnosis[]            @relation("DiagnosisUpdated")
  updatedPatients              Patient[]              @relation("PatientUpdated")
  deletedPatients              Patient[]              @relation("PatientDeleted")
  updatedDoctors               Doctor[]               @relation("DoctorUpdated")
  deletedDoctors               Doctor[]               @relation("DoctorDeleted")
  deletedSpecializations       Specialization[]        @relation("SpecializationDeleted")
  deletedDepartments           Department[]            @relation("DepartmentDeleted")
  deletedDesignations          Designation[]           @relation("DesignationDeleted")
  deletedMedicineGroups        MedicineGroup[]         @relation("MedicineGroupDeleted")
  deletedUnits                 Unit[]                  @relation("UnitDeleted")
  deletedMedicines             Medicine[]              @relation("MedicineDeleted")
  deletedBloodGroups           BloodGroup[]            @relation("BloodGroupDeleted")
  deletedAllergies             Allergy[]               @relation("AllergyDeleted")
  deletedAddresses             Address[]               @relation("AddressDeleted")
  deletedDocuments             Document[]              @relation("DocumentDeleted")
  deletedShifts                Shift[]                 @relation("ShiftDeleted")
  deletedFinancialYears        FinancialYear[]         @relation("FinancialYearDeleted")
  deletedAppointments          Appointment[]           @relation("AppointmentDeleted")
  deletedPrescriptions         Prescription[]          @relation("PrescriptionDeleted")
  deletedBills                 Bill[]                  @relation("BillDeleted")
  deletedDiagnoses             Diagnosis[]             @relation("DiagnosisDeleted")
  deletedDiagnosisSystems      DiagnosisSystem[]       @relation("DiagnosisSystemDeleted")
  deletedDispensings           Dispensing[]            @relation("DispensingDeleted")
  deletedLabOrders             LabOrder[]              @relation("LabOrderDeleted")
  deletedProcedureOrders       ProcedureOrder[]        @relation("ProcedureOrderDeleted")
  deletedRadiologyOrders       RadiologyOrder[]        @relation("RadiologyOrderDeleted")
  deletedEmployeeSchedules     EmployeeSchedule[]      @relation("EmployeeScheduleDeleted")
  updatedQueueEntries          QueueEntry[]           @relation("QueueEntryUpdated")
  updatedAppointments          Appointment[]          @relation("AppointmentUpdated")
  updatedMedicines             Medicine[]             @relation("MedicineUpdated")
  updatedPrescriptions         Prescription[]         @relation("PrescriptionUpdated")
  updatedPrescriptionItems     PrescriptionItem[]     @relation("PrescriptionItemUpdated")
  updatedLabOrders             LabOrder[]             @relation("LabOrderUpdated")
  updatedRadiologyOrders       RadiologyOrder[]       @relation("RadiologyOrderUpdated")
  updatedProcedureOrders       ProcedureOrder[]       @relation("ProcedureOrderUpdated")
  updatedBills                 Bill[]                 @relation("BillUpdated")
  updatedBillItems             BillItem[]             @relation("BillItemUpdated")
  updatedDispensings           Dispensing[]           @relation("DispensingUpdated")
  updatedShifts                Shift[]                @relation("ShiftUpdated")
  updatedEmployeeSchedules     EmployeeSchedule[]     @relation("EmployeeScheduleUpdated")
  updatedAddresses             Address[]              @relation("AddressUpdated")
  updatedDocuments             Document[]             @relation("DocumentUpdated")
  updatedCompanies             Company[]              @relation("CompanyUpdated")
  updatedPatientAllergyRecords PatientAllergyRecord[] @relation("PatientAllergyRecordUpdated")
  updatedDiagnosisSystems      DiagnosisSystem[]      @relation("DiagnosisSystemUpdated")
  updatedPrescriptionTemplates PrescriptionTemplate[] @relation("PrescriptionTemplateUpdated")
  updatedSpecializations       Specialization[]        @relation("SpecializationUpdated")
  updatedMedicineGroups        MedicineGroup[]         @relation("MedicineGroupUpdated")
  updatedUnits                 Unit[]                  @relation("UnitUpdated")
  updatedDepartments           Department[]            @relation("DepartmentUpdated")
  updatedDesignations          Designation[]           @relation("DesignationUpdated")
  updatedFinancialYears        FinancialYear[]         @relation("FinancialYearUpdated")
  updatedBloodGroups           BloodGroup[]          @relation("BloodGroupUpdated")

  @@index([userableType, userableId])
}

model Role {
  id              String           @id @default(uuid())
  name            String           @unique
  description     String?
  isSystem        Boolean          @default(false)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  createdById     String?
  updatedById     String?
  createdBy       User?            @relation("RoleCreated", fields: [createdById], references: [id])
  updatedBy       User?            @relation("RoleUpdated", fields: [updatedById], references: [id])
  users           User[]
  rolePermissions RolePermission[]
  roleMenus       RoleSidebarMenu[]
}

model Permission {
  id              String           @id @default(uuid())
  resource        String
  action          String // "read" | "create" | "update" | "delete" | "manage"
  name            String // Display name e.g. "Read Patients"
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  createdById     String?
  updatedById     String?
  createdBy       User?            @relation("PermissionCreated", fields: [createdById], references: [id])
  updatedBy       User?            @relation("PermissionUpdated", fields: [updatedById], references: [id])
  rolePermissions RolePermission[]

  @@unique([resource, action])
}

model RolePermission {
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
}

model RefreshToken {
  id          String    @id @default(uuid())
  token       String    @unique
  userId      String
  expiresAt   DateTime
  revokedAt   DateTime?
  userAgent   String?
  ipAddress   String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  createdById String?
  updatedById String?
  createdBy   User?     @relation("RefreshTokenCreated", fields: [createdById], references: [id])
  updatedBy   User?     @relation("RefreshTokenUpdated", fields: [updatedById], references: [id])
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ─── Allergy Catalog ────────────────────────────────────────

enum AllergySeverity {
  MILD
  MODERATE
  SEVERE
  LIFE_THREATENING
}

enum AllergyCategory {
  DRUG
  FOOD
  ENVIRONMENTAL
  OTHER
}

model Allergy {
  id          String          @id @default(uuid())
  name        String          @unique
  description String?
  severity    AllergySeverity @default(MODERATE)
  category    AllergyCategory @default(OTHER)
  isActive    Boolean  @default(true)
  deletedAt   DateTime?
  deletedById String?
  deletedBy   User?    @relation("AllergyDeleted", fields: [deletedById], references: [id])
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  createdById String?
  updatedById String?
  createdBy   User?           @relation("AllergyCreated", fields: [createdById], references: [id])
  updatedBy   User?           @relation("AllergyUpdated", fields: [updatedById], references: [id])

  patientAllergies PatientAllergy[]
}

model PatientAllergy {
  id               String           @id @default(uuid())
  patientId        String
  allergyId        String
  notes            String?
  severityOverride AllergySeverity?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  createdById      String?
  updatedById      String?
  createdBy        User?            @relation("PatientAllergyCreated", fields: [createdById], references: [id])
  updatedBy        User?            @relation("PatientAllergyUpdated", fields: [updatedById], references: [id])
  patient          Patient          @relation(fields: [patientId], references: [id], onDelete: Cascade)
  allergy          Allergy          @relation(fields: [allergyId], references: [id], onDelete: Cascade)

  @@unique([patientId, allergyId])
  @@index([patientId])
  @@index([allergyId])
}

// ─── Diagnosis System ───────────────────────────────────────

model DiagnosisSystem {
  id          String      @id @default(uuid())
  code        String      @unique
  name        String
  version     String?
  status      String      @default("ACTIVE") // ACTIVE | INACTIVE
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  createdById String?
  updatedById String?
  createdBy   User?       @relation("DiagnosisSystemCreated", fields: [createdById], references: [id])
  updatedBy   User?       @relation("DiagnosisSystemUpdated", fields: [updatedById], references: [id])
  diagnoses   Diagnosis[]

  deletedAt   DateTime?
  deletedById String?
  deletedBy   User?    @relation("DiagnosisSystemDeleted", fields: [deletedById], references: [id])
  @@index([code])
  @@index([createdById])
  @@index([updatedById])
}

// ─── Diagnosis Catalog ──────────────────────────────────────

model Diagnosis {
  id                String           @id @default(uuid())
  diagnosisSystemId String?
  code              String
  name              String
  description       String?
  status            String           @default("ACTIVE") // ACTIVE | INACTIVE
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  createdById       String?
  updatedById       String?
  createdBy         User?            @relation("DiagnosisCreated", fields: [createdById], references: [id])
  updatedBy         User?            @relation("DiagnosisUpdated", fields: [updatedById], references: [id])
  diagnosisSystem   DiagnosisSystem? @relation(fields: [diagnosisSystemId], references: [id])

  deletedAt   DateTime?
  deletedById String?
  deletedBy   User?    @relation("DiagnosisDeleted", fields: [deletedById], references: [id])
  @@index([diagnosisSystemId])
  @@index([code])
  @@index([createdById])
  @@index([updatedById])
}

// ─── Patient Allergy Record ─────────────────────────────────

model PatientAllergyRecord {
  id          String   @id @default(uuid())
  patientId   String
  allergen    String
  allergyType String? // DRUG | FOOD | ENVIRONMENTAL | OTHER
  reaction    String?
  severity    String? // MILD | MODERATE | SEVERE | LIFE_THREATENING
  status      String   @default("ACTIVE") // ACTIVE | INACTIVE | RESOLVED
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdById String?
  updatedById String?
  createdBy   User?    @relation("PatientAllergyRecordCreated", fields: [createdById], references: [id])
  updatedBy   User?    @relation("PatientAllergyRecordUpdated", fields: [updatedById], references: [id])
  patient     Patient  @relation(fields: [patientId], references: [id])

  @@index([patientId])
  @@index([patientId, status])
  @@index([createdById])
  @@index([updatedById])
}

// ─── Patient Vitals (immutable once created) ────────────────

model PatientVitals {
  id              String       @id @default(uuid())
  patientId       String
  appointmentId   String?
  heightCm        Float?
  weightKg        Float?
  bmi             Float?
  temperatureC    Float?
  pulseBpm        Int?
  systolicBp      Int?
  diastolicBp     Int?
  spo2Percent     Float?
  respiratoryRate Int?
  medicalStatus   String?
  recordedAt      DateTime     @default(now())
  createdAt       DateTime     @default(now())
  deletedAt       DateTime?
  deletedById     String?
  createdById     String?
  createdBy       User?        @relation("PatientVitalsCreated", fields: [createdById], references: [id])
  patient         Patient      @relation(fields: [patientId], references: [id])
  appointment     Appointment? @relation(fields: [appointmentId], references: [id])

  @@index([patientId])
  @@index([patientId, createdAt])
  @@index([appointmentId])
  @@index([createdById])
}

// ─── Doctor Specialization Catalog ──────────────────────────

model Specialization {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?
  isActive    Boolean  @default(true)
  deletedAt   DateTime?
  deletedById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdById String?
  updatedById String?
  createdBy   User?    @relation("SpecializationCreated", fields: [createdById], references: [id])
  updatedBy   User?    @relation("SpecializationUpdated", fields: [updatedById], references: [id])
  deletedBy   User?    @relation("SpecializationDeleted", fields: [deletedById], references: [id])
  doctorSpecializations DoctorSpecialization[]

  @@index([createdById])
  @@index([updatedById])
}

// ─── Department ──────────────────────────────────────────────

model Department {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?
  isActive    Boolean  @default(true)
  deletedAt   DateTime?
  deletedById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdById String?
  updatedById String?
  createdBy   User?    @relation("DepartmentCreated", fields: [createdById], references: [id])
  updatedBy   User?    @relation("DepartmentUpdated", fields: [updatedById], references: [id])
  deletedBy   User?    @relation("DepartmentDeleted", fields: [deletedById], references: [id])
  doctorDepartments DoctorDepartment[]

  @@index([createdById])
  @@index([updatedById])
}

// ─── Designation ─────────────────────────────────────────────

model Designation {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?
  isActive    Boolean  @default(true)
  deletedAt   DateTime?
  deletedById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdById String?
  updatedById String?
  createdBy   User?    @relation("DesignationCreated", fields: [createdById], references: [id])
  updatedBy   User?    @relation("DesignationUpdated", fields: [updatedById], references: [id])
  deletedBy   User?    @relation("DesignationDeleted", fields: [deletedById], references: [id])

  @@index([createdById])
  @@index([updatedById])
}

// ─── Financial Year ──────────────────────────────────────────

model FinancialYear {
  id          String   @id @default(uuid())
  name        String   @unique
  startDate   DateTime
  endDate     DateTime
  isCurrent   Boolean  @default(false)
  isActive    Boolean  @default(true)
  deletedAt   DateTime?
  deletedById String?
  deletedBy   User?    @relation("FinancialYearDeleted", fields: [deletedById], references: [id])
  companyId   String?
  company     Company? @relation(fields: [companyId], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdById String?
  updatedById String?
  createdBy   User?    @relation("FinancialYearCreated", fields: [createdById], references: [id])
  updatedBy   User?    @relation("FinancialYearUpdated", fields: [updatedById], references: [id])

  @@index([createdById])
  @@index([updatedById])
  @@index([isCurrent])
  @@index([companyId])
}

// ─── Doctor–Department join ──────────────────────────────────

model DoctorDepartment {
  id           String   @id @default(uuid())
  doctorId     String
  departmentId String
  createdAt    DateTime @default(now())
  createdById  String?
  createdBy    User?    @relation("DoctorDepartmentCreated", fields: [createdById], references: [id])
  doctor       Doctor   @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  department   Department @relation(fields: [departmentId], references: [id])

  @@unique([doctorId, departmentId])
  @@index([doctorId])
  @@index([departmentId])
}

// ─── Doctor–Specialization join ──────────────────────────────

model DoctorSpecialization {
  id                String   @id @default(uuid())
  doctorId          String
  specializationId  String
  createdAt         DateTime @default(now())
  createdById       String?
  createdBy         User?    @relation("DoctorSpecializationCreated", fields: [createdById], references: [id])
  doctor            Doctor   @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  specialization    Specialization @relation(fields: [specializationId], references: [id])

  @@unique([doctorId, specializationId])
  @@index([doctorId])
  @@index([specializationId])
}

// ─── Medicine Group ─────────────────────────────────────────

model MedicineGroup {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?
  isActive    Boolean  @default(true)
  deletedAt   DateTime?
  deletedById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdById String?
  updatedById String?
  createdBy   User?    @relation("MedicineGroupCreated", fields: [createdById], references: [id])
  updatedBy   User?    @relation("MedicineGroupUpdated", fields: [updatedById], references: [id])
  deletedBy   User?    @relation("MedicineGroupDeleted", fields: [deletedById], references: [id])
  medicines   Medicine[]

  @@index([createdById])
  @@index([updatedById])
}

// ─── Unit ────────────────────────────────────────────────────

model Unit {
  id          String   @id @default(uuid())
  name        String   @unique
  symbol      String?
  description String?
  isActive    Boolean  @default(true)
  deletedAt   DateTime?
  deletedById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdById String?
  updatedById String?
  createdBy   User?    @relation("UnitCreated", fields: [createdById], references: [id])
  updatedBy   User?    @relation("UnitUpdated", fields: [updatedById], references: [id])
  deletedBy   User?    @relation("UnitDeleted", fields: [deletedById], references: [id])
  medicines   Medicine[]

  @@index([createdById])
  @@index([updatedById])
}

model BloodGroup {
  id          String   @id @default(uuid())
  name        String   @unique
  isActive    Boolean  @default(true)
  deletedAt   DateTime?
  deletedById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdById String?
  updatedById String?
  createdBy   User?    @relation("BloodGroupCreated", fields: [createdById], references: [id])
  updatedBy   User?    @relation("BloodGroupUpdated", fields: [updatedById], references: [id])
  deletedBy   User?    @relation("BloodGroupDeleted", fields: [deletedById], references: [id])
  patients    Patient[]

  @@index([createdById])
  @@index([updatedById])
}

// ─── Clinical Models ────────────────────────────────────────

model Patient {
  id               String    @id @default(uuid())
  patientCode      String    @unique
  firstName        String
  middleName       String?
  lastName         String
  contactNo        String
  altContactNo     String?
  email            String?
  dateOfBirth      DateTime?
  gender           String?
  bloodGroup       String?
  bloodGroupId     String?
  bloodGroupRef    BloodGroup? @relation(fields: [bloodGroupId], references: [id])
  address          String?
  emergencyContact String?
  allergies        String[]
  isFollowUp       Boolean   @default(false)
  isActive         Boolean   @default(true)
  deletedAt        DateTime?
  deletedById      String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  createdById      String?
  updatedById      String?
  createdBy        User?     @relation("PatientCreated", fields: [createdById], references: [id])
  updatedBy        User?     @relation("PatientUpdated", fields: [updatedById], references: [id])
  deletedBy        User?     @relation("PatientDeleted", fields: [deletedById], references: [id])

  appointments     Appointment[]
  queueEntries     QueueEntry[]
  prescriptions    Prescription[]
  labOrders        LabOrder[]
  radiologyOrders  RadiologyOrder[]
  procedureOrders  ProcedureOrder[]
  bills            Bill[]
  patientAllergies PatientAllergy[]
  allergyRecords   PatientAllergyRecord[]
  vitals           PatientVitals[]

  @@index([patientCode])
  @@index([firstName])
  @@index([lastName])
  @@index([deletedAt])
}

model Doctor {
  id                         String   @id @default(uuid())
  qualification              String?
  specialization             String?
  medicalRegistrationNo      String   @unique
  medicalCouncil             String?
  registrationYear           Int?
  yearsOfExperience          Int?
  consultationFee            Int      @default(0)
  consultationMode           String   @default("OFFLINE") // OFFLINE | ONLINE | BOTH
  signature                  String?
  registrationCertificateUrl String?
  degreeCertificateUrl       String?
  governmentIdUrl            String?
  isActive                   Boolean  @default(true)
  deletedAt                  DateTime?
  deletedById                String?
  createdAt                  DateTime @default(now())
  updatedAt                  DateTime @updatedAt
  createdById                String?
  updatedById                String?
  createdBy                  User?    @relation("DoctorCreated", fields: [createdById], references: [id])
  updatedBy                  User?    @relation("DoctorUpdated", fields: [updatedById], references: [id])
  deletedBy                  User?    @relation("DoctorDeleted", fields: [deletedById], references: [id])

  appointments    Appointment[]
  queueEntries    QueueEntry[]
  prescriptions   Prescription[]
  labOrders       LabOrder[]
  radiologyOrders RadiologyOrder[]
  procedureOrders ProcedureOrder[]

  assignedPrescriptionTemplate PrescriptionTemplate?
  doctorDepartments    DoctorDepartment[]
  doctorSpecializations DoctorSpecialization[]

  @@index([specialization])
}

model QueueEntry {
  id            String       @id @default(uuid())
  tokenNumber   String
  patientId     String
  doctorId      String
  status        String       @default("WAITING") // WAITING | SEND_IN | IN_PROGRESS | COMPLETED | SKIPPED | NO_SHOW
  queueDate     DateTime     @default(now())
  checkedInAt   DateTime?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  createdById   String?
  updatedById   String?
  createdBy     User?        @relation("QueueEntryCreated", fields: [createdById], references: [id])
  updatedBy     User?        @relation("QueueEntryUpdated", fields: [updatedById], references: [id])
  patient       Patient      @relation(fields: [patientId], references: [id])
  doctor        Doctor       @relation(fields: [doctorId], references: [id])
  appointmentId String?      @unique
  appointment   Appointment? @relation(fields: [appointmentId], references: [id])

  @@unique([doctorId, queueDate, tokenNumber])
  @@index([doctorId, queueDate])
  @@index([patientId])
}

model Appointment {
  id                 String      @id @default(uuid())
  patientId          String
  doctorId           String
  date               DateTime
  type               String      @default("CONSULTATION")
  status             String      @default("SCHEDULED")
  tokenNumber        String?
  amount             Int         @default(0)
  registrationFee    Int         @default(0)
  reasonForVisit     String?
  notes              String?
  cancellationReason String?
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt
  createdById        String?
  updatedById        String?
  createdBy          User?       @relation("AppointmentCreated", fields: [createdById], references: [id])
  updatedBy          User?       @relation("AppointmentUpdated", fields: [updatedById], references: [id])
  patient            Patient     @relation(fields: [patientId], references: [id])
  doctor             Doctor      @relation(fields: [doctorId], references: [id])
  bill               Bill?
  queueEntry         QueueEntry?
  patientVitals      PatientVitals[]
  history            AppointmentHistory[]

  deletedAt   DateTime?
  deletedById String?
  deletedBy   User?    @relation("AppointmentDeleted", fields: [deletedById], references: [id])
  @@index([patientId])
  @@index([doctorId])
  @@index([createdById])
  @@index([updatedById])
  @@index([date])
}

model AppointmentHistory {
  id            String   @id @default(uuid())
  appointmentId String
  version       Int
  previousData  Json     // Snapshot of appointment fields before this edit
  changeType    String   @default("UPDATE") // CREATE | UPDATE
  changeReason  String?
  createdAt     DateTime @default(now())
  createdById   String?
  createdBy     User?    @relation("AppointmentHistoryCreated", fields: [createdById], references: [id])
  appointment   Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)

  @@index([appointmentId])
  @@index([appointmentId, version])
  @@index([createdById])
}

model Medicine {
  id           String        @id @default(uuid())
  name         String
  alias        String?
  genericName  String?
  brandName    String?
  category     String?
  strength     String?
  unit         String        @default("tablet")
  price        Int           @default(0)
  groupId      String?
  unitId       String?
  openingStock Decimal?      @db.Decimal(12, 2) @default(0)
  currentStock Decimal?      @db.Decimal(12, 2) @default(0)
  isActive    Boolean  @default(true)
  deletedAt   DateTime?
  deletedById String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  createdById  String?
  updatedById  String?
  createdBy    User?         @relation("MedicineCreated", fields: [createdById], references: [id])
  updatedBy    User?         @relation("MedicineUpdated", fields: [updatedById], references: [id])
  deletedBy    User?         @relation("MedicineDeleted", fields: [deletedById], references: [id])
  group        MedicineGroup? @relation(fields: [groupId], references: [id])
  unitMaster   Unit?          @relation(fields: [unitId], references: [id])

  @@index([name])
  @@index([genericName])
  @@index([alias])
  @@index([groupId])
  @@index([unitId])
}

model Prescription {
  id          String             @id @default(uuid())
  patientId   String
  doctorId    String
  diagnosis   String?
  notes       String?
  status      String             @default("ACTIVE")
  version     Int                @default(1)
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  createdById String?
  updatedById String?
  createdBy   User?              @relation("PrescriptionCreated", fields: [createdById], references: [id])
  updatedBy   User?              @relation("PrescriptionUpdated", fields: [updatedById], references: [id])
  patient     Patient            @relation(fields: [patientId], references: [id])
  doctor      Doctor             @relation(fields: [doctorId], references: [id])
  items       PrescriptionItem[]
  dispensings Dispensing[]
  history     PrescriptionHistory[]

  deletedAt   DateTime?
  deletedById String?
  deletedBy   User?    @relation("PrescriptionDeleted", fields: [deletedById], references: [id])
  @@index([patientId])
  @@index([doctorId])
  @@index([createdById])
  @@index([updatedById])
}

model PrescriptionHistory {
  id             String   @id @default(uuid())
  prescriptionId String
  version        Int
  diagnosis      String?
  notes          String?
  status         String
  items          Json     // Snapshot of PrescriptionItem[] at this version
  changeType     String   @default("UPDATE") // CREATE | UPDATE
  changeReason   String?
  createdAt      DateTime @default(now())
  createdById    String?
  createdBy      User?    @relation("PrescriptionHistoryCreated", fields: [createdById], references: [id])
  prescription   Prescription @relation(fields: [prescriptionId], references: [id], onDelete: Cascade)

  @@index([prescriptionId])
  @@index([prescriptionId, version])
  @@index([createdById])
}

model PrescriptionItem {
