model PrescriptionTemplate {
  id          String  @id @default(uuid())
  name        String
  type        String  @default("prescription") // prescription | diagnosis | test
  description String?
  isDefault   Boolean @default(false)

  // Doctor assignment (1:1, optional) — prescriptions print on this template
  // for this doctor, falling back to the global default when unassigned.
  doctorId String?  @unique
  doctor   Doctor?  @relation(fields: [doctorId], references: [id])

  // Header / branding
  logoUrl              String?
  clinicName           String?
  doctorName           String?
  doctorSpecialization String?
  doctorQualification  String?
  doctorRegNo          String?
  clinicAddress        String?
  clinicPhone          String?
  clinicEmail          String?
  clinicWebsite        String?

  // Rx layout config (JSON)
  layout Json @default("{}")
  // layout shape:
  // {
  //   showRxSymbol: boolean,
  //   showPatientFields: boolean,   // Name, Age, Sex, Adv
  //   showMedicineTable: boolean,
  //   medicineColumns: string[],     // ["Medicine", "Dosage", "Duration", "Instructions"]
  //   showRecommendations: boolean,
  //   recommendations: string[],
  //   showFooter: boolean,
  //   footerText: string,
  //   showQRCode: boolean,
  //   primaryColor: string,
  //   showBorder: boolean
  // }

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdById String?
  updatedById String?
  createdBy   User?    @relation("PrescriptionTemplateCreated", fields: [createdById], references: [id])
  updatedBy   User?    @relation("PrescriptionTemplateUpdated", fields: [updatedById], references: [id])

  @@index([isDefault])
}

/// Developer change-plan annotations captured in the Database Schema module.
model SchemaFieldChange {
  id          String   @id @default(uuid())
  modelName   String
  fieldName   String
  /// REMARK | REMOVE | EDIT | ADD
  kind        String
  remark      String?
  editedName  String?
  editedType  String?
  fieldType   String?
  /// For ADD rows of kind=ADD that represent a foreign key: target Prisma model.
  targetModel String?
  isRequired  Boolean  @default(true)
  isList      Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([modelName, fieldName, kind])
  @@index([modelName])
}

/// Developer-created modules registered through the Database/Developer tooling.
model CustomModule {
  id         String   @id
  definition Json
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

/// Configurable sidebar menu items — controls what each role can see in the nav.
model SidebarMenu {
  id          String   @id @default(uuid())
  label       String
  path        String
  icon        String?
  group       String   // "Clinic", "Reports", "Pharmacy & Billing", "Organisation", "Access Control", "Developer", "Account"
  sortOrder   Int      @default(0)
  isHidden    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  roleMenus   RoleSidebarMenu[]

  @@unique([path])
}

model RoleSidebarMenu {
  roleId        String
  sidebarMenuId String
  role          Role        @relation(fields: [roleId], references: [id], onDelete: Cascade)
  sidebarMenu   SidebarMenu @relation(fields: [sidebarMenuId], references: [id], onDelete: Cascade)

  @@id([roleId, sidebarMenuId])
}
