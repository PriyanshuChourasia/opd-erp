model Bill {
  id            String       @id @default(uuid())
  patientId     String?
  appointmentId String?      @unique
  invoiceNo     String       @unique
  subtotal      Int          @default(0)
  discount      Int          @default(0)
  tax           Int          @default(0)
  total          Int          @default(0)
  paidAmount     Int          @default(0)
  paymentMethod  String       @default("CASH")
  referenceNumber String?
  status         String       @default("PENDING")
  notes          String?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  createdById   String?
  updatedById   String?
  createdBy     User?        @relation("BillCreated", fields: [createdById], references: [id])
  updatedBy     User?        @relation("BillUpdated", fields: [updatedById], references: [id])
  patient       Patient?     @relation(fields: [patientId], references: [id])
  appointment   Appointment? @relation(fields: [appointmentId], references: [id])
  items         BillItem[]

  deletedAt   DateTime?
  deletedById String?
  deletedBy   User?    @relation("BillDeleted", fields: [deletedById], references: [id])
  @@index([patientId])
  @@index([invoiceNo])
  @@index([createdById])
  @@index([updatedById])
}

model BillItem {
  id          String   @id @default(uuid())
  billId      String
  itemType    String
