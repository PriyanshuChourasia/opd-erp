  updatedBy      User?        @relation("PrescriptionItemUpdated", fields: [updatedById], references: [id])
  prescription   Prescription @relation(fields: [prescriptionId], references: [id], onDelete: Cascade)

  @@index([prescriptionId])
  @@index([createdById])
  @@index([updatedById])
}

model LabOrder {
