  isActive    Boolean  @default(true)
  deletedAt   DateTime?
  deletedById String?
  deletedBy   User?    @relation("DocumentDeleted", fields: [deletedById], references: [id])
  documentableType String
  documentableId   String
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  createdById      String?
  updatedById      String?
  createdBy        User?    @relation("DocumentCreated", fields: [createdById], references: [id])
  updatedBy        User?    @relation("DocumentUpdated", fields: [updatedById], references: [id])

  @@index([documentableType, documentableId])
  @@index([documentableType, documentableId, isPrimary])
  @@index([createdById])
  @@index([updatedById])
}

model Company {
  id                    String          @id @default(uuid())
  name                  String
