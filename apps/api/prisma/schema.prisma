  drugLicenseNumber     String?
  drugLicenseExpiry     DateTime?
  taxRegistrationNumber String?
  createdAt             DateTime        @default(now())
  updatedAt             DateTime        @updatedAt
  createdById           String?
  updatedById           String?
  createdBy             User?           @relation("CompanyCreated", fields: [createdById], references: [id])
  updatedBy             User?           @relation("CompanyUpdated", fields: [updatedById], references: [id])
  financialYears        FinancialYear[]
