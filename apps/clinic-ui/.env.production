# Production environment — Vite loads this when running `vite build`
# Point VITE_API_BASE at your deployed NestJS backend (includes the /api global prefix).
VITE_API_BASE=https://opdapi.codymitra.com/api
VITE_APP_NAME=Doctor ERP

# Show the demo login credentials panel on the login page.
# NOTE: anyone opening the public login page can read these. Set to false for a real clinic.
VITE_SHOW_DEMO_LOGINS=true
